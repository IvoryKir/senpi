  "workspaces": {
    ".": {
      "project": ["scripts/**/*.{js,mjs,cjs,ts,mts}"],
      "entry": [
        // Root scripts are run by path (package.json scripts, CI workflows, release docs).
        "scripts/*.{js,mjs,ts}",
        "scripts/qa/*.{mjs,ts}",
        "scripts/qa/fixtures/*.mjs",
        "scripts/oxlint/*.{mjs,ts}",
        // These sidecars type an .mjs module for its importers and tests.
        "scripts/**/*.d.mts",
      ],
      "includeEntryExports": true,
    },
    ".agents/skills/senpi-qa": {
      // A private dependency island outside the npm workspaces (its own package.json).
