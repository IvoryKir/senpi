    "packages/coding-agent": {
      "entry": [
        // The CLI and package entries (package.json bin/exports point at dist/, which knip cannot map back here).
        "src/cli.ts",
        "src/rpc-entry.ts",
        "src/client/index.ts",
        // The Bun-compiled binary entry (build-binaries.sh).
        "src/bun/cli.ts",
        // Bundled as separate entries or started by path (build-coding-agent-bundle.mjs, worker URLs, child spawns).
        "src/modes/rpc/host-supervisor-entry.ts",
        "src/modes/rpc/session-worker.ts",
        "src/modes/rpc/host-lifecycle.ts",
        "src/modes/rpc/tool-child/module-job-worker.ts",
        "src/tool-child-main.ts",
        "src/utils/image-resize-worker.ts",
        // Experimental entries run by path (mini-test.sh, experimental-cli-entry.test.ts).
        "src/experimental/cli.ts",
        "src/experimental/mini/main.ts",
        // QA drivers and benchmarks run by path.
        "scripts/**/*.mjs",
        "bench/*.ts",
        // Example extensions are loaded by path (`senpi -e <file>`), never imported. The examples with
        // their own package.json are separate workspaces.
        "examples/**/*.ts",
        "!examples/extensions/{with-deps,custom-provider-anthropic,custom-provider-gitlab-duo,sandbox,gondolin}/**",
        // The vitest setup file vitest.config.ts loads by path.
        "test/setup.ts",
